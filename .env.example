# Environment Configuration — Indore Metro Platform

# Application Configuration
APP_NAME="Indore Metro Digital Web Platform"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
SECRET_KEY="indore-metro-super-secret-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=indoremetro_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/indoremetro_db

# Payment Gateway (Razorpay Test Keys)
RAZORPAY_KEY_ID="rzp_test_indore_metro_key"
RAZORPAY_KEY_SECRET="rzp_test_secret_indore_metro_secret_key"
RAZORPAY_WEBHOOK_SECRET="whsec_indore_metro_webhook_secret"

# Email SMTP Configuration
EMAIL_HOST="smtp.mailtrap.io"
EMAIL_PORT=2525
EMAIL_USERNAME=""
EMAIL_PASSWORD=""
EMAIL_FROM="no-reply@indoremetro.gov.in"
EMAIL_FROM_NAME="Indore Metro Rail Corporation"
EMAIL_ENABLED=false

# URLs
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:8000"
